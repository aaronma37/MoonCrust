#version 460
layout(local_size_x = 16, local_size_y = 8) in;

struct Vertex {
    vec4 pos;
    vec4 normal;
    vec4 color;
    vec4 weights;
    uvec4 bone_ids;
};

struct Bone {
    vec4 start_pos;
    vec4 end_pos;
    vec4 plane_start; // w is flex
    vec4 plane_end;   // w is side (1.0 = left, -1.0 = right, 0.0 = central)
};

struct RingParams {
    float pins[8]; // 8 Radial "Sticks" at 45 degree intervals
};

layout(std430, set = 0, binding = 0) buffer VertexBuffer { Vertex vertices[]; };
layout(std430, set = 0, binding = 1) readonly buffer BoneBuffer { Bone bones[]; };
layout(std430, set = 0, binding = 2) readonly buffer ParamBuffer { RingParams params[]; };

struct DrawIndexedIndirectCommand {
    uint indexCount;
    uint instanceCount;
    uint firstIndex;
    int  vertexOffset;
    uint firstInstance;
};
layout(std430, set = 0, binding = 3) buffer IndirectBuffer { DrawIndexedIndirectCommand cmd; };

layout(push_constant) uniform PC {
    uint num_bones;
    uint rings_per_bone;
    uint verts_per_ring;
    uint diagnostic_mode;
};

void main() {
    if (gl_GlobalInvocationID.x == 0 && gl_GlobalInvocationID.y == 0 && gl_GlobalInvocationID.z == 0) {
        cmd.indexCount = num_bones * (rings_per_bone - 1) * verts_per_ring * 6;
        cmd.instanceCount = 1;
        cmd.firstIndex = 0;
        cmd.vertexOffset = 0;
        cmd.firstInstance = 0;
    }

    uint theta_idx = gl_GlobalInvocationID.x;
    uint ring_idx = gl_GlobalInvocationID.y;
    uint bone_idx = gl_GlobalInvocationID.z;
    
    if (bone_idx >= num_bones || ring_idx >= rings_per_bone || theta_idx >= verts_per_ring) return;
    
    float t = float(ring_idx) / float(rings_per_bone - 1);
    float raw_theta_norm = float(theta_idx) / float(verts_per_ring);
    float theta = raw_theta_norm * 6.28318530718;
    
    Bone b = bones[bone_idx];
    vec3 p0 = b.start_pos.xyz;
    vec3 p1 = b.end_pos.xyz;
    vec3 pos_center = mix(p0, p1, t);
    
    vec3 ring_normal = normalize(mix(b.plane_start.xyz, b.plane_end.xyz, t));
    
    // STABLE BASIS
    vec3 u_ref = vec3(0, 0, 1); // World Forward
    if (abs(dot(u_ref, ring_normal)) > 0.9) u_ref = vec3(1, 0, 0); 
    
    vec3 u = normalize(cross(u_ref, ring_normal));
    vec3 v = normalize(cross(ring_normal, u));
    
    if (abs(b.plane_end.w) > 0.1) {
        u *= b.plane_end.w; 
    }
    
    // RADIAL PIN INTERPOLATION
    RingParams rp = params[bone_idx * rings_per_bone + ring_idx];
    float pin_coord = raw_theta_norm * 8.0;
    uint p0_idx = uint(floor(pin_coord)) % 8;
    uint p1_idx = (p0_idx + 1) % 8;
    float f = fract(pin_coord);
    
    float smooth_f = f * f * (3.0 - 2.0 * f);
    float r = mix(rp.pins[p0_idx], rp.pins[p1_idx], smooth_f);
    r = max(0.01, r);

    // Map Pin 0 to 'v' (Forward)
    vec3 offset = (v * cos(theta) + u * sin(theta)) * r;
    uint v_idx = bone_idx * (rings_per_bone * verts_per_ring) + ring_idx * verts_per_ring + theta_idx;
    
    vertices[v_idx].pos = vec4(pos_center + offset, 1.0);
    vertices[v_idx].normal = vec4(normalize(offset), b.plane_end.w);
    
    if (diagnostic_mode == 1) {
        vec3 base_col = vec3(0.5, 0.5, 0.5);
        if (p0_idx == 0 || p1_idx == 0) base_col = vec3(1.0, 0.0, 0.0);
        else if (p0_idx == 2 || p1_idx == 2) base_col = vec3(0.0, 1.0, 0.0);
        else if (p0_idx == 4 || p1_idx == 4) base_col = vec3(0.0, 0.0, 1.0);
        else if (p0_idx == 6 || p1_idx == 6) base_col = vec3(1.0, 1.0, 0.0);
        if (ring_idx % 2 == 0) base_col *= 0.7;
        vertices[v_idx].color = vec4(base_col, 1.0);
    } else {
        vertices[v_idx].color = vec4(0.8, 0.75, 0.7, 1.0);
    }
    
    vertices[v_idx].weights = vec4(1.0 - t, t, raw_theta_norm, t);
    vertices[v_idx].bone_ids = uvec4(uint(b.start_pos.w), uint(b.end_pos.w), 0, 0);
}
