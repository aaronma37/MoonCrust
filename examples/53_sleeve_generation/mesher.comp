#version 460
layout(local_size_x = 16, local_size_y = 8) in;

struct Vertex {
    vec4 pos;
    vec4 normal;
    vec4 color;
    vec4 weights;
    uvec4 bone_ids;
};

struct Bone {
    vec4 start_pos;
    vec4 end_pos;
    vec4 plane_start; // w is flex
    vec4 plane_end;   // w is side (1.0 = left, -1.0 = right)
};

struct SoftBody {
    vec4 pos;     // xyz = world pos, w = radius
    vec4 params;  // x = smax k, y = bone_id, z = type, w = grav_bias
    vec4 basis_x;
    vec4 basis_y;
    vec4 basis_z;
};

struct RingParams {
    float coeffs[8];
};

layout(std430, set = 0, binding = 0) buffer VertexBuffer { Vertex vertices[]; };
layout(std430, set = 0, binding = 1) readonly buffer BoneBuffer { Bone bones[]; };
layout(std430, set = 0, binding = 2) readonly buffer ParamBuffer { RingParams params[]; };
layout(std430, set = 0, binding = 3) readonly buffer SoftBodyBuffer { SoftBody soft_bodies[]; };

layout(push_constant) uniform PC {
    uint num_bones;
    uint rings_per_bone;
    uint verts_per_ring;
    uint diagnostic_mode;
    uint num_soft_bodies;
};

// Smooth Maximum (Polynomial)
float smax(float a, float b, float k) {
    float h = max(k - abs(a - b), 0.0) / k;
    return max(a, b) + h * h * k * (1.0 / 4.0);
}

// Simple Sphere Distance along ray
float ray_sphere_dist(vec3 O, vec3 D, vec3 C, float R) {
    vec3 L = C - O;
    float tca = dot(L, D);
    if (tca < 0.0) return -1.0;
    float d2 = dot(L, L) - tca * tca;
    if (d2 > R * R) return -1.0;
    float thc = sqrt(R * R - d2);
    return tca - thc; // Near side intersection
}

void main() {
    uint theta_idx = gl_GlobalInvocationID.x;
    uint ring_idx = gl_GlobalInvocationID.y;
    uint bone_idx = gl_GlobalInvocationID.z;
    
    if (bone_idx >= num_bones || ring_idx >= rings_per_bone || theta_idx >= verts_per_ring) return;
    
    float theta = (float(theta_idx) / float(verts_per_ring)) * 6.28318530718;
    float t = float(ring_idx) / float(rings_per_bone - 1);
    
    Bone b = bones[bone_idx];
    vec3 p0 = b.start_pos.xyz;
    vec3 p1 = b.end_pos.xyz;
    vec3 pos_center = mix(p0, p1, t);
    
    vec3 ring_normal = normalize(mix(b.plane_start.xyz, b.plane_end.xyz, t));
    vec3 ref = vec3(0, 0, 1);
    if (abs(dot(ref, ring_normal)) > 0.9) ref = vec3(0, 1, 0);
    vec3 u = normalize(cross(ref, ring_normal));
    vec3 v = cross(ring_normal, u);
    u *= b.plane_end.w; 
    
    float flex = b.plane_start.w;
    float bulge = flex * 0.4 * sin(t * 3.14159);
    
    RingParams rp = params[bone_idx * rings_per_bone + ring_idx];
    float r = rp.coeffs[0] * (1.0 + bulge);

    r += rp.coeffs[1] * cos(theta) + rp.coeffs[2] * sin(theta);
    r += rp.coeffs[3] * cos(2.0 * theta) + rp.coeffs[4] * sin(2.0 * theta);
    r += rp.coeffs[5] * cos(3.0 * theta) + rp.coeffs[6] * sin(3.0 * theta);

    // SOFT BODY INTEGRATION (SDF Radius Merging)
    vec3 vertex_dir = u * cos(theta) + v * sin(theta);
    vec3 vertex_normal = vertex_dir;
    float total_skew = 0.0;

    for (uint i = 0; i < num_soft_bodies; i++) {
        SoftBody sb = soft_bodies[i];
        
        uint anchor_idx = uint(sb.params.y);
        bool is_in_neighborhood = (bone_idx == anchor_idx || bone_idx == anchor_idx + 1 || (anchor_idx > 0 && bone_idx == anchor_idx - 1));
        
        if (!is_in_neighborhood) continue;
        if (length(sb.pos.xyz - pos_center) > 3.0) continue; 
        
        float d_sphere = ray_sphere_dist(pos_center, vertex_dir, sb.pos.xyz, sb.pos.w);
        
        if (d_sphere > 0.0) {
            float r_old = r;
            r = smax(r, d_sphere, sb.params.x);
            
            // ANATOMICAL SKEW: Pull the protruding part downward based on gravity bias
            // sb.params.w is the 'Grav Bias' passed from Lua (sin(pitch) * magnitude)
            float protrusion = max(0.0, r - r_old);
            total_skew += protrusion * sb.params.w;

            vec3 surface_pos = pos_center + vertex_dir * r;
            vec3 world_n = normalize(surface_pos - sb.pos.xyz);
            float h = clamp(protrusion / sb.params.x, 0.0, 1.0);
            vertex_normal = normalize(mix(vertex_normal, world_n, h));
        }
    }
    r = max(0.05, r);

    vec3 offset = vertex_dir * r;
    vec3 final_pos = pos_center + offset;
    
    // Apply the vertical skew (Rigid Droop)
    vec3 bone_up = normalize(b.plane_start.xyz); // Local up-ish direction
    final_pos += vec3(0, -1, 0) * total_skew;

    uint v_idx = bone_idx * (rings_per_bone * verts_per_ring) + ring_idx * verts_per_ring + theta_idx;
    vertices[v_idx].pos = vec4(final_pos, 1.0);
    vertices[v_idx].normal = vec4(vertex_normal, 0.0);

    if (diagnostic_mode == 1) {
        vertices[v_idx].color = vec4(vertex_dir * 0.5 + 0.5, 1.0);
    } else {
        vec3 skin_col = vec3(0.8, 0.75, 0.7);
        vec3 flex_col = vec3(1.0, 0.1, 0.1);
        vertices[v_idx].color = vec4(mix(skin_col, flex_col, 0.0), 1.0);
    }
    
    vertices[v_idx].weights = vec4(1.0 - t, t, 0.0, 0.0);
    vertices[v_idx].bone_ids = uvec4(uint(b.start_pos.w), uint(b.end_pos.w), 0, 0);
}
