#version 460
// SDF_INSERT_POINT

layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

struct Vertex {
    vec4 pos;
    vec4 normal;
    vec4 color;
    vec4 weights;
    uvec4 bone_ids;
};

struct GridNode {
    float dist;
    uint  id;
    vec3  normal;
    vec3  pos;
};

layout(std430, set = 0, binding = 0) buffer GridBuffer { GridNode nodes[]; };
layout(std430, set = 0, binding = 1) buffer VertexBuffer { Vertex vertices[]; };
layout(std430, set = 0, binding = 3) buffer CellBuffer { uint cell_vertex_idx[]; };
layout(std430, set = 0, binding = 4) buffer CounterBuffer { uint counts[]; };

layout(push_constant) uniform PC {
    uint head_bone_id;
};

void main() {
    uvec3 id = gl_GlobalInvocationID;
    if (id.x >= 32 || id.y >= 32 || id.z >= 32) return;
    
    uint cell_idx = id.z * 32 * 32 + id.y * 32 + id.x;
    cell_vertex_idx[cell_idx] = 0xFFFFFFFF;

    if (id.x >= 31 || id.y >= 31 || id.z >= 31) return;

    // Check 8 corners of the cell
    uint corners[8];
    corners[0] = cell_idx;
    corners[1] = cell_idx + 1;
    corners[2] = cell_idx + 32;
    corners[3] = cell_idx + 33;
    corners[4] = cell_idx + 32 * 32;
    corners[5] = cell_idx + 32 * 32 + 1;
    corners[6] = cell_idx + 32 * 32 + 32;
    corners[7] = cell_idx + 32 * 32 + 33;

    bool has_surface = false;
    float d0 = nodes[corners[0]].dist;
    for(int i=1; i<8; i++) {
        if((d0 > 0.0) != (nodes[corners[i]].dist > 0.0)) {
            has_surface = true;
            break;
        }
    }

    if (has_surface) {
        vec3 avg_p = vec3(0);
        vec3 avg_n = vec3(0);
        int count = 0;
        for(int i=0; i<8; i++) {
            avg_p += nodes[corners[i]].pos;
            avg_n += nodes[corners[i]].normal;
            count++;
        }
        
        uint v_idx = atomicAdd(counts[6], 1); 
        cell_vertex_idx[cell_idx] = v_idx;
        
        vertices[v_idx].pos = vec4(avg_p / float(count), 1.0);
        vertices[v_idx].normal = vec4(normalize(avg_n), 1.0);
        vertices[v_idx].color = vec4(0.8, 0.75, 0.7, 1.0); 
        vertices[v_idx].weights = vec4(1, 0, 0, 0); 
        vertices[v_idx].bone_ids = uvec4(head_bone_id, 0, 0, 0); 
    }
}
