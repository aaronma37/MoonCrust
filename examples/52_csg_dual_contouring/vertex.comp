#version 460
#extension GL_EXT_nonuniform_qualifier : require

layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

struct GridNode {
    float dist;
    uint id;
    uint color_packed;
    uint padding;
    uvec4 bone_ids;
    vec4 bone_weights;
};

struct Vertex {
    vec4 position;
    vec4 normal;
    vec4 color;
    uvec4 bone_ids;
    vec4 bone_weights;
};

struct IndirectCommand {
    uint indexCount;
    uint instanceCount;
    uint firstIndex;
    int  vertexOffset;
    uint firstInstance;
};

layout(set = 0, binding = 0, std430) buffer AllBuffers { uint data[]; } all_bufs[];

layout(push_constant) uniform PC {
    vec3 bounds_min;
    uint bone_count;
    vec3 bounds_max;
    uint sdf_count;
    uvec3 grid_size;
    uint padding;
    uint bones_idx;
    uint sdfs_idx;
    uint grid_idx;
    uint vertices_idx;
    uint indices_idx;
    uint counter_idx;
    uint cell_idx;
    uint vertex_counter_idx;
} pc;

// --- SDF Primitives ---
float sdSphere(vec3 p, float s) { return length(p) - s; }
float sdBox(vec3 p, vec3 b) { vec3 q = abs(p) - b; return length(max(q, 0.0)) + min(max(q.x, max(q.y, q.z)), 0.0); }
float sdCapsule(vec3 p, vec3 a, vec3 b, float r) {
    vec3 pa = p - a, ba = b - a;
    float h = clamp(dot(pa, ba) / dot(ba, ba), 0.0, 1.0);
    return length(pa - ba * h) - r;
}
float sdEllipsoid(vec3 p, vec3 r) {
    float k0 = length(p / r);
    float k1 = length(p / (r * r));
    return k0 * (k0 - 1.0) / k1;
}
float opSmoothUnion(float d1, float d2, float k) {
    float h = clamp(0.5 + 0.5 * (d2 - d1) / k, 0.0, 1.0);
    return mix(d2, d1, h) - k * h * (1.0 - h);
}

struct Bone {
    mat4 world_matrix;
    mat4 inv_world_matrix;
    mat4 bind_matrix;
    mat4 inv_bind_matrix;
    float bounding_radius;
    uint sdf_offset;
    uint sdf_count;
    uint padding;
};

struct SDFDescriptor {
    uint bone_index;
    uint primitive_type;
    uint id;
    uint color_packed;
    vec4 params;
    vec4 local_offset;
};

Bone get_bone(uint idx) {
    uint base = idx * 68;
    Bone b;
    for(int i=0; i<4; i++) for(int j=0; j<4; j++) b.world_matrix[i][j] = uintBitsToFloat(all_bufs[nonuniformEXT(pc.bones_idx)].data[base + i*4 + j]);
    for(int i=0; i<4; i++) for(int j=0; j<4; j++) b.inv_world_matrix[i][j] = uintBitsToFloat(all_bufs[nonuniformEXT(pc.bones_idx)].data[base + 16 + i*4 + j]);
    for(int i=0; i<4; i++) for(int j=0; j<4; j++) b.bind_matrix[i][j] = uintBitsToFloat(all_bufs[nonuniformEXT(pc.bones_idx)].data[base + 32 + i*4 + j]);
    for(int i=0; i<4; i++) for(int j=0; j<4; j++) b.inv_bind_matrix[i][j] = uintBitsToFloat(all_bufs[nonuniformEXT(pc.bones_idx)].data[base + 48 + i*4 + j]);
    b.bounding_radius = uintBitsToFloat(all_bufs[nonuniformEXT(pc.bones_idx)].data[base + 64]);
    b.sdf_offset = all_bufs[nonuniformEXT(pc.bones_idx)].data[base + 65];
    b.sdf_count = all_bufs[nonuniformEXT(pc.bones_idx)].data[base + 66];
    return b;
}

SDFDescriptor get_sdf(uint idx) {
    uint base = idx * 12;
    SDFDescriptor s;
    s.bone_index = all_bufs[nonuniformEXT(pc.sdfs_idx)].data[base + 0];
    s.primitive_type = all_bufs[nonuniformEXT(pc.sdfs_idx)].data[base + 1];
    s.id = all_bufs[nonuniformEXT(pc.sdfs_idx)].data[base + 2];
    s.color_packed = all_bufs[nonuniformEXT(pc.sdfs_idx)].data[base + 3];
    s.params = vec4(uintBitsToFloat(all_bufs[nonuniformEXT(pc.sdfs_idx)].data[base + 4]),
                    uintBitsToFloat(all_bufs[nonuniformEXT(pc.sdfs_idx)].data[base + 5]),
                    uintBitsToFloat(all_bufs[nonuniformEXT(pc.sdfs_idx)].data[base + 6]),
                    uintBitsToFloat(all_bufs[nonuniformEXT(pc.sdfs_idx)].data[base + 7]));
    s.local_offset = vec4(uintBitsToFloat(all_bufs[nonuniformEXT(pc.sdfs_idx)].data[base + 8]),
                          uintBitsToFloat(all_bufs[nonuniformEXT(pc.sdfs_idx)].data[base + 9]),
                          uintBitsToFloat(all_bufs[nonuniformEXT(pc.sdfs_idx)].data[base + 10]),
                          uintBitsToFloat(all_bufs[nonuniformEXT(pc.sdfs_idx)].data[base + 11]));
    return s;
}

float evaluate_sdf(vec3 pos) {
    float min_dist = 1000.0;
    uint closest_id = 0;
    for (uint i = 0; i < pc.bone_count; i++) {
        Bone b = get_bone(i);
        vec3 local_p = (b.inv_world_matrix * vec4(pos, 1.0)).xyz;
        if (length(local_p) > b.bounding_radius + 0.5) continue;
        for (uint j = 0; j < b.sdf_count; j++) {
            SDFDescriptor sdf = get_sdf(b.sdf_offset + j);
            vec3 p = local_p - sdf.local_offset.xyz;
            float d = 1000.0;
            if (sdf.primitive_type == 0) d = sdSphere(p, sdf.params.x);
            else if (sdf.primitive_type == 1) d = sdCapsule(p, vec3(0, sdf.params.y, 0), vec3(0, sdf.params.z, 0), sdf.params.x);
            else if (sdf.primitive_type == 2) d = sdBox(p, sdf.params.xyz);
            else if (sdf.primitive_type == 3) d = sdEllipsoid(p, sdf.params.xyz);
            
            bool is_first = (closest_id == 0);
            bool should_blend = (sdf.id == closest_id) || is_first || (sdf.id < 50 && closest_id < 50);
            if (d < min_dist) {
                if (!is_first && should_blend) min_dist = opSmoothUnion(min_dist, d, 0.06);
                else { min_dist = d; closest_id = sdf.id; }
            } else if (!is_first && should_blend) min_dist = opSmoothUnion(min_dist, d, 0.06);
        }
    }
    return min_dist;
}

uint get_grid_idx(uvec3 c) { 
    c = clamp(c, uvec3(0), pc.grid_size - 1);
    return c.x + c.y * pc.grid_size.x + c.z * pc.grid_size.x * pc.grid_size.y; 
}

GridNode get_grid(uint idx) {
    uint base = idx * 12;
    GridNode n;
    n.dist = uintBitsToFloat(all_bufs[nonuniformEXT(pc.grid_idx)].data[base + 0]);
    n.id = all_bufs[nonuniformEXT(pc.grid_idx)].data[base + 1];
    n.color_packed = all_bufs[nonuniformEXT(pc.grid_idx)].data[base + 2];
    n.bone_ids = uvec4(all_bufs[nonuniformEXT(pc.grid_idx)].data[base + 4],
                       all_bufs[nonuniformEXT(pc.grid_idx)].data[base + 5],
                       all_bufs[nonuniformEXT(pc.grid_idx)].data[base + 6],
                       all_bufs[nonuniformEXT(pc.grid_idx)].data[base + 7]);
    n.bone_weights = vec4(uintBitsToFloat(all_bufs[nonuniformEXT(pc.grid_idx)].data[base + 8]),
                          uintBitsToFloat(all_bufs[nonuniformEXT(pc.grid_idx)].data[base + 9]),
                          uintBitsToFloat(all_bufs[nonuniformEXT(pc.grid_idx)].data[base + 10]),
                          uintBitsToFloat(all_bufs[nonuniformEXT(pc.grid_idx)].data[base + 11]));
    return n;
}

// Vertex is 16 + 16 + 16 + 16 + 16 = 80 bytes. 20 uints.
void set_vertex(uint idx, Vertex v) {
    uint base = idx * 20;
    for(int i=0; i<4; i++) all_bufs[nonuniformEXT(pc.vertices_idx)].data[base + 0 + i] = floatBitsToUint(v.position[i]);
    for(int i=0; i<4; i++) all_bufs[nonuniformEXT(pc.vertices_idx)].data[base + 4 + i] = floatBitsToUint(v.normal[i]);
    for(int i=0; i<4; i++) all_bufs[nonuniformEXT(pc.vertices_idx)].data[base + 8 + i] = floatBitsToUint(v.color[i]);
    all_bufs[nonuniformEXT(pc.vertices_idx)].data[base + 12] = v.bone_ids.x;
    all_bufs[nonuniformEXT(pc.vertices_idx)].data[base + 13] = v.bone_ids.y;
    all_bufs[nonuniformEXT(pc.vertices_idx)].data[base + 14] = v.bone_ids.z;
    all_bufs[nonuniformEXT(pc.vertices_idx)].data[base + 15] = v.bone_ids.w;
    for(int i=0; i<4; i++) all_bufs[nonuniformEXT(pc.vertices_idx)].data[base + 16 + i] = floatBitsToUint(v.bone_weights[i]);
}

void main() {
    uvec3 g_id = gl_GlobalInvocationID;
    
    if (g_id.x >= pc.grid_size.x - 1 || g_id.y >= pc.grid_size.y - 1 || g_id.z >= pc.grid_size.z - 1) {
        if (g_id.x < pc.grid_size.x && g_id.y < pc.grid_size.y && g_id.z < pc.grid_size.z) {
            all_bufs[nonuniformEXT(pc.cell_idx)].data[get_grid_idx(g_id)] = 0xFFFFFFFF;
        }
        return;
    }

    uint sign_changes = 0;
    float d[8];
    for(uint i=0; i<8; i++) {
        d[i] = uintBitsToFloat(all_bufs[nonuniformEXT(pc.grid_idx)].data[get_grid_idx(g_id + uvec3(i&1, (i>>1)&1, (i>>2)&1)) * 12]);
    }
    
    float min_d = 1000.0; uint best_corner = 0;
    for (uint i=0; i<8; i++) {
        if ((d[0] < 0.0) != (d[i] < 0.0)) sign_changes++;
        if (d[i] < min_d) { min_d = d[i]; best_corner = i; }
    }

    uint cell_idx = get_grid_idx(g_id);
    if (sign_changes == 0) {
        all_bufs[nonuniformEXT(pc.cell_idx)].data[cell_idx] = 0xFFFFFFFF;
        return;
    }

    uint v_idx = atomicAdd(all_bufs[nonuniformEXT(pc.vertex_counter_idx)].data[0], 1);
    all_bufs[nonuniformEXT(pc.cell_idx)].data[cell_idx] = v_idx;

    vec3 p_sum = vec3(0.0); int p_count = 0;
    vec3 vs = (pc.bounds_max - pc.bounds_min) / vec3(max(uvec3(1), pc.grid_size - 1));
    vec3 p0 = pc.bounds_min + vec3(g_id) * vs;

    #define ADD_EDGE(a, b, oa, ob) if ((d[a] < 0.0) != (d[b] < 0.0)) { float t = d[a] / (d[a] - d[b]); p_sum += p0 + mix(oa, ob, t) * vs; p_count++; }
    ADD_EDGE(0, 1, vec3(0,0,0), vec3(1,0,0)); ADD_EDGE(2, 3, vec3(0,1,0), vec3(1,1,0));
    ADD_EDGE(4, 5, vec3(0,0,1), vec3(1,0,1)); ADD_EDGE(6, 7, vec3(0,1,1), vec3(1,1,1));
    ADD_EDGE(0, 2, vec3(0,0,0), vec3(0,1,0)); ADD_EDGE(1, 3, vec3(1,0,0), vec3(1,1,0));
    ADD_EDGE(4, 6, vec3(0,0,1), vec3(0,1,1)); ADD_EDGE(5, 7, vec3(1,0,1), vec3(1,1,1));
    ADD_EDGE(0, 4, vec3(0,0,0), vec3(0,0,1)); ADD_EDGE(1, 5, vec3(1,0,0), vec3(1,0,1));
    ADD_EDGE(2, 6, vec3(0,1,0), vec3(0,1,1)); ADD_EDGE(3, 7, vec3(1,1,0), vec3(1,1,1));

    vec3 pos = p_sum / float(max(1, p_count));
    
    // Analytic Normal (SDF Gradient)
    const float eps = 0.001;
    vec3 n = normalize(vec3(
        evaluate_sdf(pos + vec3(eps, 0, 0)) - evaluate_sdf(pos - vec3(eps, 0, 0)),
        evaluate_sdf(pos + vec3(0, eps, 0)) - evaluate_sdf(pos - vec3(0, eps, 0)),
        evaluate_sdf(pos + vec3(0, 0, eps)) - evaluate_sdf(pos - vec3(0, 0, eps))
    ));

    GridNode best = get_grid(get_grid_idx(g_id + uvec3(best_corner&1, (best_corner>>1)&1, (best_corner>>2)&1)));
    Vertex v;
    v.position = vec4(pos, 1.0); v.normal = vec4(n, 1.0);
    float r = float((best.color_packed >> 16) & 0xFF) / 255.0;
    float g = float((best.color_packed >> 8) & 0xFF) / 255.0;
    float b = float(best.color_packed & 0xFF) / 255.0;
    v.color = vec4(r, g, b, uintBitsToFloat(best.id));
    v.bone_ids = best.bone_ids; v.bone_weights = best.bone_weights;

    if (v_idx < 256 * 1024) set_vertex(v_idx, v);
}