#version 450
#extension GL_EXT_nonuniform_qualifier : require

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 2, r32ui) uniform uimage3D all_storage_images[];
layout(set = 0, binding = 0) buffer GlobalBuffers { uint data[]; } world[];

struct PlayerState {
    vec3 pos;
    float padding0;
    vec3 vel;
    uint grounded;
    uint padding[8];
};

// Accessing player state through the bindless buffer array (binding 0)
layout(set = 0, binding = 0) buffer PlayerBuffer { PlayerState s; } player_storage[];

layout(push_constant) uniform PushConstants {
    vec3 input_dir;
    float dt;
    uint img_idx;
    uint grid_w;
    uint grid_h;
    uint grid_d;
    float hover_target;
    float hover_strength;
    uint player_buf_idx;
} pc;

bool is_solid(ivec3 p) {
    if (any(lessThan(p, ivec3(0))) || any(greaterThanEqual(p, ivec3(pc.grid_w, pc.grid_h, pc.grid_d)))) return false;
    uint val = imageLoad(all_storage_images[nonuniformEXT(pc.img_idx)], p).r;
    return val > 0 && val != 10;
}

bool check_aabb(vec3 pos, vec3 size) {
    vec3 min_p = pos - size * 0.5;
    vec3 max_p = pos + size * 0.5;
    
    for (int z = int(floor(min_p.z)); z <= int(floor(max_p.z)); z++) {
        for (int y = int(floor(min_p.y)); y <= int(floor(max_p.y)); y++) {
            for (int x = int(floor(min_p.x)); x <= int(floor(max_p.x)); x++) {
                if (is_solid(ivec3(x, y, z))) return true;
            }
        }
    }
    return false;
}

void main() {
    uint p_idx = nonuniformEXT(pc.player_buf_idx);
    vec3 size = vec3(1.8, 3.8, 1.8);
    vec3 p = player_storage[p_idx].s.pos;
    vec3 v = player_storage[p_idx].s.vel;

    // 1. Gravity & Forces
    float gravity = -30.0;
    v.y += gravity * pc.dt;
    
    // Hover Dynamics
    if (pc.hover_strength > 0.1) {
        float dist_to_floor = 100.0;
        bool found_floor = false;
        for (int i = 1; i <= 8; i++) {
            if (is_solid(ivec3(floor(p.x), floor(p.y - i), floor(p.z)))) {
                dist_to_floor = float(i);
                found_floor = true;
                break;
            }
        }
        
        if (found_floor) {
            float force = (pc.hover_target - dist_to_floor) * pc.hover_strength - v.y * 10.0;
            v.y += force * pc.dt;
        }
    }

    // Horizontal Movement
    float friction = player_storage[p_idx].s.grounded > 0 ? 15.0 : 2.0;
    v.xz += pc.input_dir.xz * 60.0 * pc.dt;
    v.xz -= v.xz * friction * pc.dt;

    // 2. Integration & Collision
    vec3 next_y = p + vec3(0, v.y * pc.dt, 0);
    if (check_aabb(next_y, size)) {
        if (v.y < 0) player_storage[p_idx].s.grounded = 1;
        v.y = 0;
    } else {
        p = next_y;
        player_storage[p_idx].s.grounded = 0;
    }

    vec3 next_x = p + vec3(v.x * pc.dt, 0, 0);
    if (check_aabb(next_x, size)) v.x = 0;
    else p = next_x;

    vec3 next_z = p + vec3(0, 0, v.z * pc.dt);
    if (check_aabb(next_z, size)) v.z = 0;
    else p = next_z;

    player_storage[p_idx].s.pos = p;
    player_storage[p_idx].s.vel = v;
}
