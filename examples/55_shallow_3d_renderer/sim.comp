#version 450
#extension GL_EXT_nonuniform_qualifier : require

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 2, r32ui) uniform uimage3D all_storage_images[];
layout(set = 0, binding = 0) buffer GlobalBuffers { uint data[]; } world[];

layout(push_constant) uniform PushConstants {
    uint in_img;
    uint out_img;
    uint signal_img;
    uint grid_w, grid_h, grid_d;
    uint active_map_idx;
    uint dirty_map_idx;
} pc;

void mark_chunk(ivec3 p) {
    if (any(lessThan(p, ivec3(0))) || any(greaterThanEqual(p, ivec3(pc.grid_w, pc.grid_h, pc.grid_d)))) return;
    ivec3 cp = p / 16;
    uint chunk_idx = cp.x + (cp.y * (pc.grid_w/16)) + (cp.z * (pc.grid_w/16) * (pc.grid_h/16));
    atomicOr(world[nonuniformEXT(pc.active_map_idx)].data[chunk_idx], 1);
}

void main() {
    ivec3 pos = ivec3(gl_GlobalInvocationID.xyz);
    if (any(greaterThanEqual(pos, ivec3(pc.grid_w, pc.grid_h, pc.grid_d)))) return;

    ivec3 cp = pos / 16;
    uint chunk_idx = cp.x + (cp.y * (pc.grid_w/16)) + (cp.z * (pc.grid_w/16) * (pc.grid_h/16));
    if (world[nonuniformEXT(pc.active_map_idx)].data[chunk_idx] == 0) return;

    uint current = imageLoad(all_storage_images[nonuniformEXT(pc.in_img)], pos).r;
    uint sig = imageLoad(all_storage_images[nonuniformEXT(pc.signal_img)], pos).r;
    
    // Stage 1 Baseline: Basic Decay
    if (sig > 0) {
        sig = uint(float(sig) * 0.95);
        imageStore(all_storage_images[nonuniformEXT(pc.signal_img)], pos, uvec4(sig));
        mark_chunk(pos);
    }

    if ((current & 0xFF) == 10) {
        imageStore(all_storage_images[nonuniformEXT(pc.out_img)], pos, uvec4(10));
        return;
    }

    uint mat = current & 0xFF;
    uint next = current;
    
    // Standard CA neighbor logic
    if (mat == 0 || mat == 1) { 
        int neighbors = 0;
        for (int z = -1; z <= 1; z++) {
            for (int y = -1; y <= 1; y++) {
                for (int x = -1; x <= 1; x++) {
                    if (x == 0 && y == 0 && z == 0) continue;
                    ivec3 n_pos = pos + ivec3(x, y, z);
                    if (all(greaterThanEqual(n_pos, ivec3(0))) && all(lessThan(n_pos, ivec3(pc.grid_w, pc.grid_h, pc.grid_d)))) {
                        uint n_mat = imageLoad(all_storage_images[nonuniformEXT(pc.in_img)], n_pos).r & 0xFF;
                        if (n_mat > 0 && n_mat != 10 && n_mat < 20) neighbors++;
                    }
                }
            }
        }
        if (mat == 1) { if (neighbors < 4 || neighbors > 8) next = 0; }
        else if (mat == 0) { if (neighbors >= 6 && neighbors <= 10) next = 1; }
    }

    imageStore(all_storage_images[nonuniformEXT(pc.out_img)], pos, uvec4(next));
    if (current != next) mark_chunk(pos);
}
