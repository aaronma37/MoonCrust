#version 450
#extension GL_EXT_nonuniform_qualifier : require

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 2, r32ui) uniform uimage3D all_storage_images[];
layout(set = 0, binding = 0) buffer GlobalBuffers { uint data[]; } world[];

layout(push_constant) uniform PushConstants {
    uint in_img;
    uint out_img;
    uint light_in_img;
    uint light_out_img;
    uint grid_w, grid_h, grid_d;
    uint active_map_idx;
    uint dirty_map_idx;
    uint out_active_map_idx;
} pc;

void mark_self(ivec3 p, bool physical_change) {
    ivec3 cp = p / 16;
    uint chunk_idx = cp.x + (cp.y * (pc.grid_w/16)) + (cp.z * (pc.grid_w/16) * (pc.grid_h/16));
    atomicOr(world[nonuniformEXT(pc.out_active_map_idx)].data[chunk_idx], 1);
    if (physical_change) {
        atomicOr(world[nonuniformEXT(pc.dirty_map_idx)].data[chunk_idx], 1);
    }
}

void mark_neighbors(ivec3 p) {
    ivec3 offsets[6] = {
        ivec3(16,0,0), ivec3(-16,0,0),
        ivec3(0,16,0), ivec3(0,-16,0),
        ivec3(0,0,16), ivec3(0,0,-16)
    };
    for (int i = 0; i < 6; i++) {
        ivec3 np = p + offsets[i];
        if (any(lessThan(np, ivec3(0))) || any(greaterThanEqual(np, ivec3(pc.grid_w, pc.grid_h, pc.grid_d)))) continue;
        ivec3 cp = np / 16;
        uint chunk_idx = cp.x + (cp.y * (pc.grid_w/16)) + (cp.z * (pc.grid_w/16) * (pc.grid_h/16));
        atomicOr(world[nonuniformEXT(pc.out_active_map_idx)].data[chunk_idx], 1);
    }
}

void main() {
    ivec3 pos = ivec3(gl_GlobalInvocationID.xyz);
    if (any(greaterThanEqual(pos, ivec3(pc.grid_w, pc.grid_h, pc.grid_d)))) return;

    ivec3 cp = pos / 16;
    uint chunk_idx = cp.x + (cp.y * (pc.grid_w/16)) + (cp.z * (pc.grid_w/16) * (pc.grid_h/16));
    if (world[nonuniformEXT(pc.active_map_idx)].data[chunk_idx] == 0) return;

    uint current = imageLoad(all_storage_images[nonuniformEXT(pc.in_img)], pos).r;
    uint mat = current & 0xFF;
    
    // Light Propagation (Max-based diffusion)
    uint light_out = 0;
    
    if (pos.y >= pc.grid_h - 1) {
        // Sunlight injection
        light_out = 255 | (240 << 8) | (220 << 16);
    } else if (mat == 0 || mat == 10) { // Air or Robot
        vec3 max_light = vec3(0.0);
        
        ivec3 offsets[7] = {
            ivec3(0,0,0), // self
            ivec3(1,0,0), ivec3(-1,0,0),
            ivec3(0,1,0), ivec3(0,-1,0),
            ivec3(0,0,1), ivec3(0,0,-1)
        };
        
        for (int i = 0; i < 7; i++) {
            ivec3 np = pos + offsets[i];
            if (all(greaterThanEqual(np, ivec3(0))) && all(lessThan(np, ivec3(pc.grid_w, pc.grid_h, pc.grid_d)))) {
                uint nl = imageLoad(all_storage_images[nonuniformEXT(pc.light_in_img)], np).r;
                if (nl > 0) {
                    float r = float(nl & 0xFF);
                    float g = float((nl >> 8) & 0xFF);
                    float b = float((nl >> 16) & 0xFF);
                    
                    if (offsets[i] == ivec3(0, 1, 0) && r > 250.0 && g > 230.0) {
                        // Sunlight falls straight down without decay
                        max_light = max(max_light, vec3(r, g, b)); 
                    } else if (i == 0) {
                        // Self slowly decays if no neighbors have higher light
                        max_light = max(max_light, vec3(r, g, b) * 0.95);
                    } else {
                        // Propagate from neighbors with decay
                        max_light = max(max_light, vec3(r, g, b) * 0.90);
                    }
                }
            }
        }
        
        uint nr = uint(max_light.r);
        uint ng = uint(max_light.g);
        uint nb = uint(max_light.b);
        if (nr > 5 || ng > 5 || nb > 5) {
            light_out = nr | (ng << 8) | (nb << 16);
        }
    } else if (mat == 3) {
        // Example: Material 3 is emissive blue crystal
        light_out = 50 | (100 << 8) | (255 << 16);
    }
    
    // Always take max with incoming light
    uint light_in = imageLoad(all_storage_images[nonuniformEXT(pc.light_in_img)], pos).r;
    if (light_in > 0) {
        uint nr = max(light_out & 0xFF, light_in & 0xFF);
        uint ng = max((light_out >> 8) & 0xFF, (light_in >> 8) & 0xFF);
        uint nb = max((light_out >> 16) & 0xFF, (light_in >> 16) & 0xFF);
        if (mat != 0 && mat != 3) {
            nr = uint(float(nr) * 0.5); ng = uint(float(ng) * 0.5); nb = uint(float(nb) * 0.5);
        }
        light_out = nr | (ng << 8) | (nb << 16);
    }
    
    imageStore(all_storage_images[nonuniformEXT(pc.light_out_img)], pos, uvec4(light_out));
    if (light_in != light_out) {
        mark_self(pos, false);
        // If we are at the border of a chunk, wake up the neighbor
        ivec3 lp = pos % 16;
        if (lp.x == 0 || lp.x == 15 || lp.y == 0 || lp.y == 15 || lp.z == 0 || lp.z == 15) {
            mark_neighbors(pos);
        }
    }

    if (mat == 10) {
        imageStore(all_storage_images[nonuniformEXT(pc.out_img)], pos, uvec4(10));
        return;
    }

    uint next = current;
    // (CA logic disabled)
    imageStore(all_storage_images[nonuniformEXT(pc.out_img)], pos, uvec4(next));
    if (current != next) {
        mark_self(pos, true);
        mark_neighbors(pos);
    }
}
