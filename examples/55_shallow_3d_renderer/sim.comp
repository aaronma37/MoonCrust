#version 450
#extension GL_EXT_nonuniform_qualifier : require

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 2, r32ui) uniform uimage3D all_storage_images[];
layout(set = 0, binding = 3, r16f) uniform image3D all_signal_images[];
layout(set = 0, binding = 0) buffer GlobalBuffers { uint data[]; } world[];

layout(push_constant) uniform PushConstants {
    uint in_img;
    uint out_img;
    uint signal_img;
    uint grid_w, grid_h, grid_d;
    uint active_map_idx;
    uint dirty_map_idx;
} pc;

void mark_chunk(ivec3 p) {
    if (any(lessThan(p, ivec3(0))) || any(greaterThanEqual(p, ivec3(pc.grid_w, pc.grid_h, pc.grid_d)))) return;
    ivec3 cp = p / 16;
    uint chunk_res_x = pc.grid_w / 16;
    uint chunks_per_slice = (pc.grid_w / 16) * (pc.grid_h / 16);
    uint chunk_idx = cp.x + (cp.y * chunk_res_x) + (cp.z * chunks_per_slice);
    atomicOr(world[nonuniformEXT(pc.active_map_idx)].data[chunk_idx], 1);
    atomicOr(world[nonuniformEXT(pc.dirty_map_idx)].data[chunk_idx], 1);
}

void main() {
    ivec3 pos = ivec3(gl_GlobalInvocationID.xyz);
    if (any(greaterThanEqual(pos, ivec3(pc.grid_w, pc.grid_h, pc.grid_d)))) return;

    ivec3 cp = pos / 16;
    uint chunk_res_x = pc.grid_w / 16;
    uint chunks_per_slice = (pc.grid_w / 16) * (pc.grid_h / 16);
    uint chunk_idx = cp.x + (cp.y * chunk_res_x) + (cp.z * chunks_per_slice);

    // Only simulate active chunks
    if (world[nonuniformEXT(pc.active_map_idx)].data[chunk_idx] == 0) return;

    uint current = imageLoad(all_storage_images[nonuniformEXT(pc.in_img)], pos).r;
    float hormone = imageLoad(all_signal_images[nonuniformEXT(pc.signal_img)], pos).r;
    
    // Hormone Decay (Evaporation)
    if (hormone > 0.0) {
        imageStore(all_signal_images[nonuniformEXT(pc.signal_img)], pos, vec4(hormone * 0.9, 0, 0, 0));
        mark_chunk(pos); // Keep simulating as long as hormone is active
    }

    // Player (Type 10) is immutable and handled by player.comp
    if (current == 10) {
        imageStore(all_storage_images[nonuniformEXT(pc.out_img)], pos, uvec4(10, 0, 0, 0));
        return;
    }

    uint mat = current & 0xFF;
    uint next = current;

    // SIGNALED GROWTH
    if (mat == 0) {
        if (hormone > 0.8) next = 20; // Strong signal = Wood
        else if (hormone > 0.1) next = 21; // Weak signal = Leaf
    }
    
    // Standard CA neighbor logic
    if (mat == 0 || mat == 1) { // Only run CA on air or simple cells (birth)
        int neighbors = 0;
        for (int z = -1; z <= 1; z++) {
            for (int y = -1; y <= 1; y++) {
                for (int x = -1; x <= 1; x++) {
                    if (x == 0 && y == 0 && z == 0) continue;
                    ivec3 n_pos = pos + ivec3(x, y, z);
                    if (all(greaterThanEqual(n_pos, ivec3(0))) && all(lessThan(n_pos, ivec3(pc.grid_w, pc.grid_h, pc.grid_d)))) {
                        uint n_val = imageLoad(all_storage_images[nonuniformEXT(pc.in_img)], n_pos).r;
                        uint n_mat = n_val & 0xFF;
                        if (n_mat > 0 && n_mat != 10 && n_mat < 20) neighbors++;
                    }
                }
            }
        }

        if (mat == 1) { // Survival
            if (neighbors < 4 || neighbors > 8) next = 0;
        } else if (mat == 0) { // Birth
            if (neighbors >= 6 && neighbors <= 10) next = 1;
        }
    }

    imageStore(all_storage_images[nonuniformEXT(pc.out_img)], pos, uvec4(next, 0, 0, 0));

    if (current != next) {
        mark_chunk(pos);
        if (pos.x % 16 == 0) mark_chunk(pos + ivec3(-1, 0, 0));
        if (pos.x % 16 == 15) mark_chunk(pos + ivec3(1, 0, 0));
        if (pos.y % 16 == 0) mark_chunk(pos + ivec3(0, -1, 0));
        if (pos.y % 16 == 15) mark_chunk(pos + ivec3(0, 1, 0));
        if (pos.z % 16 == 0) mark_chunk(pos + ivec3(0, 0, -1));
        if (pos.z % 16 == 15) mark_chunk(pos + ivec3(0, 0, 1));
    }
}
