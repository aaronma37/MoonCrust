#version 450
#extension GL_EXT_nonuniform_qualifier : require

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 2, r32ui) uniform uimage3D all_storage_images[];

layout(push_constant) uniform PushConstants {
    uint img;
    uint grid_w, grid_h, grid_d;
} pc;

float hash(vec3 p) {
    p = fract(p * 0.3183099 + 0.1);
    p *= 17.0;
    return fract(p.x * p.y * p.z * (p.x + p.y + p.z));
}

void main() {
    ivec3 pos = ivec3(gl_GlobalInvocationID.x, gl_GlobalInvocationID.y, gl_GlobalInvocationID.z);
    if (pos.x >= pc.grid_w || pos.y >= pc.grid_h || pos.z >= pc.grid_d) return;

    uint val = 0;
    
    // Floor at y=0
    if (pos.y == 0) {
        if (((pos.x / 8) + (pos.z / 8)) % 2 == 0) {
            val = 1;
        } else {
            val = 2;
        }
    }
    
    // Border walls
    if (pos.y >= 0 && pos.y < 8) {
        if (pos.x == 0 || pos.x == pc.grid_w - 1 || pos.z == 0 || pos.z == pc.grid_d - 1) {
            val = 7;
        }
    }

    // Random pillars/blocks (more of them and taller)
    if (pos.y > 0 && pos.y < 24) {
        float h = hash(vec3(pos.x / 16, 0, pos.z / 16));
        if (h > 0.90) {
            val = uint(3 + uint(h * 100) % 4);
        }
    }
    
    // Some "room" structures
    if (pos.y >= 0 && pos.y < 12) {
        // A few rooms across the map
        ivec2 grid_pos = ivec2(pos.xz) / 128;
        ivec2 local_room = ivec2(pos.xz) % 128;
        if (local_room.x > 40 && local_room.x < 80 && local_room.y > 40 && local_room.y < 80) {
            if (pos.y == 0) val = 8;
            else if (local_room.x == 41 || local_room.x == 79 || local_room.y == 41 || local_room.y == 79) {
                if (!(local_room.x > 58 && local_room.x < 62)) { // Doorway
                    val = 9;
                }
            }
        }
    }

    imageStore(all_storage_images[nonuniformEXT(pc.img)], pos, uvec4(val));
}
