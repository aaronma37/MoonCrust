#version 450
#extension GL_EXT_nonuniform_qualifier : require

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 2, r32ui) uniform uimage3D all_storage_images[];
layout(set = 0, binding = 0) buffer GlobalBuffers { uint data[]; } world[];

layout(push_constant) uniform PushConstants {
    uint img;
    uint grid_w, grid_h, grid_d;
    uint active_map_idx;
    uint dirty_map_idx;
    uint stats_buf_idx;
} pc;

void mark_chunk(ivec3 p, bool simulation_needed) {
    uint chunk_res_x = pc.grid_w / 16;
    uint chunks_per_slice = (pc.grid_w / 16) * (pc.grid_h / 16);
    ivec3 c = p / 16;
    uint idx = c.x + c.y * chunk_res_x + c.z * chunks_per_slice;
    
    // Always mark as dirty for initial meshing
    atomicOr(world[nonuniformEXT(pc.dirty_map_idx)].data[idx], 1);
    
    if (simulation_needed) {
        uint prev = atomicOr(world[nonuniformEXT(pc.active_map_idx)].data[idx], 1);
        if (prev == 0) {
            atomicAdd(world[nonuniformEXT(pc.stats_buf_idx)].data[0], 1);
        }
    }
}

float hash(vec3 p) {
    p = fract(p * 0.3183099 + 0.1);
    p *= 17.0;
    return fract(p.x * p.y * p.z * (p.x + p.y + p.z));
}

void main() {
    ivec3 pos = ivec3(gl_GlobalInvocationID.x, gl_GlobalInvocationID.y, gl_GlobalInvocationID.z);
    if (pos.x >= pc.grid_w || pos.y >= pc.grid_h || pos.z >= pc.grid_d) return;

    uint val = 0;
    bool needs_sim = false;
    
    // Floor at y=0
    if (pos.y == 0) {
        if (((pos.x / 8) + (pos.z / 8)) % 2 == 0) {
            val = 1; needs_sim = true;
        } else {
            val = 2; needs_sim = true;
        }
    }
    
    // Border walls
    if (pos.y >= 0 && pos.y < 8) {
        if (pos.x == 0 || pos.x == pc.grid_w - 1 || pos.z == 0 || pos.z == pc.grid_d - 1) {
            val = 7;
        }
    }

    // Random pillars/blocks (more of them and taller)
    if (pos.y > 0 && pos.y < 24) {
        float h = hash(vec3(pos.x / 16, 0, pos.z / 16));
        if (h > 0.90) {
            val = uint(3 + uint(h * 100) % 4);
        }
    }
    
    // Some "room" structures
    if (pos.y >= 0 && pos.y < 12) {
        // A few rooms across the map
        ivec2 grid_pos = ivec2(pos.xz) / 128;
        ivec2 local_room = ivec2(pos.xz) % 128;
        if (local_room.x > 40 && local_room.x < 80 && local_room.y > 40 && local_room.y < 80) {
            if (pos.y == 0) val = 8;
            else if (local_room.x == 41 || local_room.x == 79 || local_room.y == 41 || local_room.y == 79) {
                if (!(local_room.x > 58 && local_room.x < 62)) { // Doorway
                    val = 9;
                }
            }
        }
    }

    if (val > 0) mark_chunk(pos, needs_sim);
    imageStore(all_storage_images[nonuniformEXT(pc.img)], pos, uvec4(val));
}
