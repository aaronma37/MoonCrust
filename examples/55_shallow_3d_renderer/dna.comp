#version 450
#extension GL_EXT_nonuniform_qualifier : require

layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 2, r32ui) uniform uimage3D all_storage_images[];
layout(set = 0, binding = 0) buffer GlobalBuffers { uint data[]; } world[];

struct Entity {
    vec3 pos;
    float age;
    uint type;
    uint parent_id;
    uint child_count;
    uint energy;
    uint padding[8];
};

layout(set = 0, binding = 0) buffer EntityBuffer { Entity e[]; } entities[];

layout(push_constant) uniform PushConstants {
    uint img_idx;
    uint light_img;
    uint entity_buf_idx;
    uint grid_w, grid_h, grid_d;
    uint active_map_idx;
    uint dirty_map_idx;
    uint out_active_map_idx;
    uint stats_buf_idx;
    float dt;
} pc;

void mark_self(ivec3 p) {
    if (any(lessThan(p, ivec3(0))) || any(greaterThanEqual(p, ivec3(pc.grid_w, pc.grid_h, pc.grid_d)))) return;
    ivec3 cp = p / 16;
    uint chunk_idx = cp.x + (cp.y * (pc.grid_w/16)) + (cp.z * (pc.grid_w/16) * (pc.grid_h/16));
    uint prev = atomicOr(world[nonuniformEXT(pc.out_active_map_idx)].data[chunk_idx], 1);
    if (prev == 0) {
        atomicAdd(world[nonuniformEXT(pc.stats_buf_idx)].data[0], 1);
    }
}

void mark_neighbors(ivec3 p) {
    ivec3 offsets[6] = {
        ivec3(16,0,0), ivec3(-16,0,0),
        ivec3(0,16,0), ivec3(0,-16,0),
        ivec3(0,0,16), ivec3(0,0,-16)
    };
    for (int i = 0; i < 6; i++) {
        ivec3 np = p + offsets[i];
        if (any(lessThan(np, ivec3(0))) || any(greaterThanEqual(np, ivec3(pc.grid_w, pc.grid_h, pc.grid_d)))) continue;
        ivec3 cp = np / 16;
        uint chunk_idx = cp.x + (cp.y * (pc.grid_w/16)) + (cp.z * (pc.grid_w/16) * (pc.grid_h/16));
        uint prev = atomicOr(world[nonuniformEXT(pc.out_active_map_idx)].data[chunk_idx], 1);
        if (prev == 0) {
            atomicAdd(world[nonuniformEXT(pc.stats_buf_idx)].data[0], 1);
        }
    }
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint e_idx = nonuniformEXT(pc.entity_buf_idx);
    
    if (entities[e_idx].e[idx].type == 0) return;

    // Wake up current chunk for next tick
    mark_self(ivec3(entities[e_idx].e[idx].pos));

    if (entities[e_idx].e[idx].type == 1) {
        entities[e_idx].e[idx].age += pc.dt;
        ivec3 base_pos = ivec3(entities[e_idx].e[idx].pos);
        
        if (entities[e_idx].e[idx].energy > 0) {
            int tip_y = 0;
            bool found_top = false;
            for (int y = 0; y < 64; y++) {
                ivec3 p = base_pos + ivec3(0, y, 0);
                if (any(lessThan(p, ivec3(0))) || any(greaterThanEqual(p, ivec3(pc.grid_w, pc.grid_h, pc.grid_d)))) continue;
                uint val = imageLoad(all_storage_images[nonuniformEXT(pc.img_idx)], p).r;
                if ((val & 0xFF) == 0) {
                    tip_y = p.y;
                    found_top = true;
                    break;
                }
            }

            if (found_top) {
                ivec3 tip_pos = ivec3(base_pos.x, tip_y, base_pos.z);
                if (all(greaterThanEqual(tip_pos, ivec3(0))) && all(lessThan(tip_pos, ivec3(pc.grid_w, pc.grid_h, pc.grid_d)))) {
                    // DNA entity injects bright green light (0x0000FF00 -> R=0, G=255, B=0)
                    uint green_light = (255 << 8);
                    imageStore(all_storage_images[nonuniformEXT(pc.light_img)], tip_pos, uvec4(green_light));
                    mark_self(tip_pos);
                    mark_neighbors(tip_pos);
                }
                entities[e_idx].e[idx].energy -= 1; 
            }
        }
    }
}
