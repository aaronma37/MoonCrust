#version 450
#extension GL_EXT_nonuniform_qualifier : require

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 2, r32ui) uniform uimage3D all_storage_images[];
layout(set = 0, binding = 0) buffer GlobalBuffers { uint data[]; } world[];

struct PlayerState {
    vec3 pos;
    float yaw;
    vec3 vel;
    float p1;
    uint grounded;
    uint debug_dist;
    uint debug_found;
    uint p2;
    uint padding[4];
};

layout(set = 0, binding = 0) buffer PlayerBuffer { PlayerState s; } player_storage[];

layout(push_constant) uniform PushConstants {
    uint img_a;
    uint img_b;
    uint grid_w, grid_h, grid_d;
    uint active_map_idx;
    uint dirty_map_idx;
    uint player_buf_idx;
    uint plant_seed;
} pc;

void mark_chunk(ivec3 p) {
    if (p.x < 0 || p.x >= pc.grid_w || p.y < 0 || p.y >= pc.grid_h || p.z < 0 || p.z >= pc.grid_d) return;
    uint chunk_res_x = pc.grid_w / 16;
    uint chunks_per_slice = (pc.grid_w / 16) * (pc.grid_h / 16);
    ivec3 c = p / 16;
    uint idx = c.x + c.y * chunk_res_x + c.z * chunks_per_slice;
    atomicOr(world[nonuniformEXT(pc.dirty_map_idx)].data[idx], 1);
    atomicOr(world[nonuniformEXT(pc.active_map_idx)].data[idx], 1);
}

void main() {
    uint p_idx = nonuniformEXT(pc.player_buf_idx);
    vec3 p = player_storage[p_idx].s.pos;
    
    // NO MORE PAINTING THE ROBOT (Material 10) INTO THE GRID.
    // This allows the robot to be a continuous entity.

    if (pc.plant_seed > 0) {
        ivec3 ip = ivec3(floor(p));
        if (all(greaterThanEqual(ip, ivec3(0))) && all(lessThan(ip, ivec3(pc.grid_w, pc.grid_h, pc.grid_d)))) {
            // Force plant an emissive crystal (material 3) into both buffers
            imageStore(all_storage_images[nonuniformEXT(pc.img_a)], ip, uvec4(3));
            imageStore(all_storage_images[nonuniformEXT(pc.img_b)], ip, uvec4(3));
            mark_chunk(ip);
        }
    }
}
