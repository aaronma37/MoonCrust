#version 450
#extension GL_EXT_nonuniform_qualifier : require

layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

layout(set = 0, binding = 2, r32ui) uniform uimage3D all_storage_images[];
layout(set = 0, binding = 0) buffer GlobalBuffers { uint data[]; } world[];

layout(push_constant) uniform PushConstants {
    uint in_img;
    uint dirty_buf;
    uint v_buf;
    uint indirect_buf;
    uint grid_w, grid_h, grid_d;
} pc;

shared uint local_vertex_count;

const uint MAX_VERTS_PER_CHUNK = 16384;

// Packing: X(9), Y(7), Z(9), Norm(3), Col(4) = 32 bits
uint pack_vertex(ivec3 p, uint norm, uint col) {
    return (uint(p.x) & 511) | ((uint(p.y) & 127) << 9) | ((uint(p.z) & 511) << 16) | ((norm & 7) << 25) | ((col & 15) << 28);
}

void main() {
    uint cx = gl_WorkGroupID.x;
    uint cy = gl_WorkGroupID.y;
    uint cz = gl_WorkGroupID.z;
    uint chunks_per_row = pc.grid_w / 16;
    uint chunks_per_slice = (pc.grid_w / 16) * (pc.grid_h / 16);
    uint chunk_idx = cx + cy * chunks_per_row + cz * chunks_per_slice;
    
    if (world[nonuniformEXT(pc.dirty_buf)].data[chunk_idx] == 0) return;

    if (gl_LocalInvocationIndex == 0) {
        local_vertex_count = 0;
    }
    barrier();

    ivec3 chunk_origin = ivec3(gl_WorkGroupID) * 16;
    
    for (int i = 0; i < 8; i++) {
        uint idx = gl_LocalInvocationIndex * 8 + i;
        ivec3 local_pos = ivec3(idx % 16, (idx / 16) % 16, idx / 256);
        ivec3 pos = chunk_origin + local_pos;
        
        if (pos.x >= pc.grid_w || pos.y >= pc.grid_h || pos.z >= pc.grid_d) continue;

        uint val = imageLoad(all_storage_images[nonuniformEXT(pc.in_img)], pos).r;
        if (val == 0) continue;

        ivec3 dirs[6] = { ivec3(1,0,0), ivec3(-1,0,0), ivec3(0,1,0), ivec3(0,-1,0), ivec3(0,0,1), ivec3(0,0,-1) };
        for (int d = 0; d < 6; d++) {
            ivec3 n_pos = pos + dirs[d];
            bool visible = false;
            if (n_pos.x < 0 || n_pos.x >= pc.grid_w || n_pos.y < 0 || n_pos.y >= pc.grid_h || n_pos.z < 0 || n_pos.z >= pc.grid_d) visible = true;
            else if (imageLoad(all_storage_images[nonuniformEXT(pc.in_img)], n_pos).r == 0) visible = true;

            if (visible) {
                uint v_off = atomicAdd(local_vertex_count, 4);
                if (v_off + 4 <= MAX_VERTS_PER_CHUNK) {
                    uint global_v_start = chunk_idx * MAX_VERTS_PER_CHUNK + v_off;
                    uint packed = pack_vertex(pos, d, val);
                    world[nonuniformEXT(pc.v_buf)].data[global_v_start + 0] = packed;
                    world[nonuniformEXT(pc.v_buf)].data[global_v_start + 1] = packed;
                    world[nonuniformEXT(pc.v_buf)].data[global_v_start + 2] = packed;
                    world[nonuniformEXT(pc.v_buf)].data[global_v_start + 3] = packed;
                }
            }
        }
    }

    barrier();

    if (gl_LocalInvocationIndex == 0) {
        world[nonuniformEXT(pc.dirty_buf)].data[chunk_idx] = 0;
        uint count = min(local_vertex_count, MAX_VERTS_PER_CHUNK);
        uint cmd_off = chunk_idx * 5;
        world[nonuniformEXT(pc.indirect_buf)].data[cmd_off + 0] = (count / 4) * 6;
        world[nonuniformEXT(pc.indirect_buf)].data[cmd_off + 1] = 1;
        world[nonuniformEXT(pc.indirect_buf)].data[cmd_off + 2] = 0;
        world[nonuniformEXT(pc.indirect_buf)].data[cmd_off + 3] = chunk_idx * MAX_VERTS_PER_CHUNK;
        world[nonuniformEXT(pc.indirect_buf)].data[cmd_off + 4] = 0;
    }
}
