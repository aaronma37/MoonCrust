#version 450
#extension GL_EXT_nonuniform_qualifier : require

layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

layout(set = 0, binding = 2, r32ui) uniform uimage3D all_storage_images[];
layout(set = 0, binding = 0) buffer GlobalBuffers { uint data[]; } world[];

layout(push_constant) uniform PushConstants {
    uint in_img;
    uint dirty_map_idx;
    uint v_buf;
    uint indirect_buf;
    uint grid_w, grid_h, grid_d;
    uint active_map_idx;
    int px, py, pz;
} pc;

shared uint local_vertex_count;
const uint MAX_VERTS_PER_CHUNK = 16384; // Increased budget

uint pack_vertex(ivec3 lp, uint norm, uint mat, uint ao) {
    return (uint(lp.x) & 15) | ((uint(lp.y) & 15) << 4) | ((uint(lp.z) & 15) << 8) | 
           ((norm & 7) << 12) | ((mat & 255) << 15) | ((ao & 3) << 23);
}

bool is_solid(ivec3 p) {
    if (p.x < 0 || p.x >= pc.grid_w || p.y < 0 || p.y >= pc.grid_h || p.z < 0 || p.z >= pc.grid_d) return false;
    return (imageLoad(all_storage_images[nonuniformEXT(pc.in_img)], p).r & 0xFF) > 0;
}

uint vertex_ao(ivec3 p, ivec3 d1, ivec3 d2) {
    bool s1 = is_solid(p + d1);
    bool s2 = is_solid(p + d2);
    bool corner = is_solid(p + d1 + d2);
    if (s1 && s2) return 0;
    return 3 - (uint(s1) + uint(s2) + uint(corner));
}

void main() {
    uint chunk_idx = gl_WorkGroupID.x + gl_WorkGroupID.y * (pc.grid_w/16) + gl_WorkGroupID.z * (pc.grid_w/16) * (pc.grid_h/16);
    ivec3 chunk_origin = ivec3(gl_WorkGroupID) * 16;
    
    if (world[nonuniformEXT(pc.dirty_map_idx)].data[chunk_idx] == 0) return;
    
    if (gl_LocalInvocationIndex == 0) local_vertex_count = 0;
    barrier();

    for (int i = 0; i < 8; i++) {
        uint idx = gl_LocalInvocationIndex * 8 + i;
        ivec3 lp = ivec3(idx % 16, (idx / 16) % 16, idx / 256);
        ivec3 p = chunk_origin + lp;
        
        uint val = imageLoad(all_storage_images[nonuniformEXT(pc.in_img)], p).r;
        uint mat = val & 0xFF;
        if (mat == 0) continue;

        ivec3 dirs[6] = { ivec3(1,0,0), ivec3(-1,0,0), ivec3(0,1,0), ivec3(0,-1,0), ivec3(0,0,1), ivec3(0,0,-1) };
        for (int d = 0; d < 6; d++) {
            ivec3 n_pos = p + dirs[d];
            if (!is_solid(n_pos)) {
                uint v_off = atomicAdd(local_vertex_count, 4);
                if (v_off + 4 <= MAX_VERTS_PER_CHUNK) {
                    uint g_start = chunk_idx * MAX_VERTS_PER_CHUNK + v_off;
                    
                    uint ao[4];
                    if (d == 0) { // +X
                        ao[0] = vertex_ao(n_pos, ivec3(0,0,-1), ivec3(0,-1,0));
                        ao[1] = vertex_ao(n_pos, ivec3(0,0,-1), ivec3(0,1,0));
                        ao[2] = vertex_ao(n_pos, ivec3(0,0,1), ivec3(0,1,0));
                        ao[3] = vertex_ao(n_pos, ivec3(0,0,1), ivec3(0,-1,0));
                    } else if (d == 1) { // -X
                        ao[0] = vertex_ao(n_pos, ivec3(0,0,1), ivec3(0,-1,0));
                        ao[1] = vertex_ao(n_pos, ivec3(0,0,1), ivec3(0,1,0));
                        ao[2] = vertex_ao(n_pos, ivec3(0,0,-1), ivec3(0,1,0));
                        ao[3] = vertex_ao(n_pos, ivec3(0,0,-1), ivec3(0,-1,0));
                    } else if (d == 2) { // +Y
                        ao[0] = vertex_ao(n_pos, ivec3(-1,0,0), ivec3(0,0,1));
                        ao[1] = vertex_ao(n_pos, ivec3(1,0,0), ivec3(0,0,1));
                        ao[2] = vertex_ao(n_pos, ivec3(1,0,0), ivec3(0,0,-1));
                        ao[3] = vertex_ao(n_pos, ivec3(-1,0,0), ivec3(0,0,-1));
                    } else if (d == 3) { // -Y
                        ao[0] = vertex_ao(n_pos, ivec3(-1,0,0), ivec3(0,0,-1));
                        ao[1] = vertex_ao(n_pos, ivec3(1,0,0), ivec3(0,0,-1));
                        ao[2] = vertex_ao(n_pos, ivec3(1,0,0), ivec3(0,0,1));
                        ao[3] = vertex_ao(n_pos, ivec3(-1,0,0), ivec3(0,0,1));
                    } else if (d == 4) { // +Z
                        ao[0] = vertex_ao(n_pos, ivec3(1,0,0), ivec3(0,-1,0));
                        ao[1] = vertex_ao(n_pos, ivec3(1,0,0), ivec3(0,1,0));
                        ao[2] = vertex_ao(n_pos, ivec3(-1,0,0), ivec3(0,1,0));
                        ao[3] = vertex_ao(n_pos, ivec3(-1,0,0), ivec3(0,-1,0));
                    } else { // -Z
                        ao[0] = vertex_ao(n_pos, ivec3(-1,0,0), ivec3(0,-1,0));
                        ao[1] = vertex_ao(n_pos, ivec3(-1,0,0), ivec3(0,1,0));
                        ao[2] = vertex_ao(n_pos, ivec3(1,0,0), ivec3(0,1,0));
                        ao[3] = vertex_ao(n_pos, ivec3(1,0,0), ivec3(0,-1,0));
                    }

                    for(int j=0; j<4; j++) {
                        world[nonuniformEXT(pc.v_buf)].data[g_start + j] = pack_vertex(lp, d, mat, ao[j]);
                    }
                }
            }
        }
    }

    barrier();
    if (gl_LocalInvocationIndex == 0) {
        uint count = min(local_vertex_count, MAX_VERTS_PER_CHUNK);
        uint cmd_off = chunk_idx * 5;
        world[nonuniformEXT(pc.indirect_buf)].data[cmd_off + 0] = (count / 4) * 6;
        world[nonuniformEXT(pc.indirect_buf)].data[cmd_off + 1] = 1;
        world[nonuniformEXT(pc.indirect_buf)].data[cmd_off + 2] = 0;
        world[nonuniformEXT(pc.indirect_buf)].data[cmd_off + 3] = chunk_idx * MAX_VERTS_PER_CHUNK;
        world[nonuniformEXT(pc.indirect_buf)].data[cmd_off + 4] = 0;
    }
}
