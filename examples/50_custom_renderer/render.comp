#version 450
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

layout(local_size_x = 8, local_size_y = 8) in;

struct Transform { vec4 pos_scale; vec4 quat; };
struct Material { vec4 base_color; float roughness, metallic, emissive; uint type; };
struct Sphere { vec4 data; };
struct BVHNode { int left, right; int pad0, pad1; vec4 min_p, max_p; };
struct Entry { uint64_t key, value; };

layout(set = 0, binding = 0, scalar) buffer TransformSoA { Transform tfs[]; } all_tfs[];
layout(set = 0, binding = 0, scalar) buffer MaterialSoA { Material mats[]; } all_mats[];
layout(set = 0, binding = 0, scalar) buffer SphereSoA { Sphere spheres[]; } all_spheres[];
layout(set = 0, binding = 0, scalar) buffer BVHBuffer { BVHNode nodes[]; } all_bvhs[];
layout(set = 0, binding = 0, scalar) buffer SortBuffer { Entry entries[]; } all_entries[];
layout(set = 0, binding = 2, rgba32f) uniform writeonly image2D all_images[];

layout(push_constant) uniform PushConstants {
    vec4 cam_pos, cam_dir, cam_up, cam_right;
    vec2 res; float time; uint num_blocks;
    uint tf_id, mat_id, img_id, grid_id, idx_id, use_shadows, sphere_id, coarse_id, bitmask_id, bvh_id, root_id;
} pc;

vec3 rotate_vector(vec3 v, vec4 q) {
    return v + 2.0 * cross(q.xyz, cross(q.xyz, v) + q.w * v);
}

vec3 rotate_vector_inv(vec3 v, vec4 q) {
    vec4 q_inv = vec4(-q.xyz, q.w);
    return rotate_vector(v, q_inv);
}

// Robust AABB intersection
bool intersect_aabb(vec3 ro, vec3 rd, vec3 box_min, vec3 box_max, out float t_near, out float t_far) {
    vec3 inv_rd = 1.0 / (rd + sign(rd) * 1e-9); // Prevent div by zero
    vec3 t0 = (box_min - ro) * inv_rd;
    vec3 t1 = (box_max - ro) * inv_rd;
    vec3 tmin = min(t0, t1);
    vec3 tmax = max(t0, t1);
    t_near = max(tmin.x, max(tmin.y, tmin.z));
    t_far = min(tmax.x, min(tmax.y, tmax.z));
    return t_near <= t_far && t_far >= 0.0;
}

bool intersect_obb(vec3 ro, vec3 rd, uint id, out float t) {
    vec4 s = all_spheres[pc.sphere_id].spheres[id].data;
    vec3 oc = ro - s.xyz;
    float b = dot(oc, rd), c = dot(oc, oc) - s.w * s.w;
    if (c > 0.0 && b > 0.0) return false;
    float h = b*b - c; if (h < 0.0) return false;

    Transform tf = all_tfs[pc.tf_id].tfs[id];
    vec3 l_ro = rotate_vector_inv(ro - tf.pos_scale.xyz, tf.quat);
    vec3 l_rd = rotate_vector_inv(rd, tf.quat);
    vec3 inv_l_rd = 1.0 / (l_rd + sign(l_rd) * 1e-9);
    float s_half = tf.pos_scale.w * 0.5;
    vec3 t0 = (-vec3(s_half) - l_ro) * inv_l_rd, t1 = (vec3(s_half) - l_ro) * inv_l_rd;
    vec3 tmin = min(t0, t1), tmax = max(t0, t1);
    float tn = max(tmin.x, max(tmin.y, tmin.z)), tf_hit = min(tmax.x, min(tmax.y, tmax.z));
    if (tn <= tf_hit && tf_hit >= 0.0) { 
        t = max(tn, 0.0); // Clamp to 0 if inside
        return true; 
    }
    return false;
}

vec3 get_obb_normal(vec3 ro, vec3 rd, uint id, float t) {
    Transform tf = all_tfs[pc.tf_id].tfs[id];
    vec3 l_ro = rotate_vector_inv(ro - tf.pos_scale.xyz, tf.quat), l_rd = rotate_vector_inv(rd, tf.quat);
    vec3 hit_p = l_ro + l_rd * t;
    float s_half = tf.pos_scale.w * 0.5;
    vec3 n = vec3(0.0);
    if (abs(hit_p.x - s_half) < 0.001) n = vec3(1,0,0);
    else if (abs(hit_p.x + s_half) < 0.001) n = vec3(-1,0,0);
    else if (abs(hit_p.y - s_half) < 0.001) n = vec3(0,1,0);
    else if (abs(hit_p.y + s_half) < 0.001) n = vec3(0,-1,0);
    else if (abs(hit_p.z - s_half) < 0.001) n = vec3(0,0,1);
    else if (abs(hit_p.z + s_half) < 0.001) n = vec3(0,0,-1);
    return normalize(rotate_vector(n, tf.quat));
}

void main() {
    uvec2 pixel = gl_GlobalInvocationID.xy;
    if (pixel.x >= uint(pc.res.x) || pixel.y >= uint(pc.res.y)) return;
    vec2 uv = (vec2(pixel) / pc.res) * 2.0 - 1.0; uv.x *= pc.res.x / pc.res.y;
    vec3 rd = normalize(pc.cam_dir.xyz + pc.cam_right.xyz * uv.x + pc.cam_up.xyz * uv.y), ro = pc.cam_pos.xyz;

    float hit_t = 1e30; int hit_id = -1;
    int stack[64]; int stack_ptr = 0;
    stack[stack_ptr++] = int(pc.root_id); 

    while (stack_ptr > 0) {
        int curr = stack[--stack_ptr];
        if (curr < 0) {
            uint id = uint(all_entries[pc.idx_id].entries[-curr - 1].value);
            float t; if (intersect_obb(ro, rd, id, t)) {
                if (t < hit_t) { hit_t = t; hit_id = int(id); }
            }
            continue;
        }
        BVHNode node = all_bvhs[pc.bvh_id].nodes[curr];
        float t_near, t_far;
        if (intersect_aabb(ro, rd, node.min_p.xyz, node.max_p.xyz, t_near, t_far)) {
            // Only traverse if the node is closer than our best hit
            // If t_near < 0, we are inside the box, so we must traverse.
            if (max(t_near, 0.0) < hit_t) {
                stack[stack_ptr++] = node.right;
                stack[stack_ptr++] = node.left;
            }
        }
    }

    vec3 color = vec3(0.1, 0.2, 0.4) + max(rd.y, 0.0) * vec3(0.3, 0.4, 0.5);
    if (hit_id != -1) {
        vec3 hit_n = get_obb_normal(ro, rd, uint(hit_id), hit_t);
        Material mat = all_mats[pc.mat_id].mats[hit_id];
        color = mat.base_color.rgb * (max(dot(hit_n, normalize(vec3(0.5, 1.0, 0.3))), 0.0) * 1.5 + 0.2);
        if (mat.emissive > 0.0) color += mat.base_color.rgb * mat.emissive;
    }

    const float a = 2.51, b = 0.03, c = 2.43, d = 0.59, e = 0.14;
    color = clamp((color * (a * color + b)) / (color * (c * color + d) + e), 0.0, 1.0);
    imageStore(all_images[pc.img_id], ivec2(pixel), vec4(color, 1.0));
}
