#version 450
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

struct Entry { uint64_t key, value; };
struct Sphere { vec4 data; };
struct BVHNode { int left, right; int pad0, pad1; vec4 min_p, max_p; };

layout(set = 0, binding = 0, scalar) buffer SortBuffer { Entry entries[]; } all_entries[];
layout(set = 0, binding = 0, scalar) buffer SphereSoA { Sphere spheres[]; } all_spheres[];
layout(set = 0, binding = 0, scalar) coherent buffer BVHBuffer { BVHNode nodes[]; } all_bvhs[];
layout(set = 0, binding = 0, scalar) coherent buffer AtomicBuffer { uint counters[]; } all_atomics[];
layout(set = 0, binding = 0, scalar) buffer ParentBuffer { int parents[]; } all_parents[];

layout(push_constant) uniform PC { uint sphere_id, entry_id, bvh_id, atomic_id, parent_id, num_leaves; } pc;

layout (local_size_x = 256) in;

void main() {
    uint id = gl_GlobalInvocationID.x;
    uint N = pc.num_leaves;
    if (id >= N) return;

    // 1. Pre-populate Leaf AABB in unified buffer
    uint leaf_buf_idx = (N - 1) + id;
    uint block_id = uint(all_entries[pc.entry_id].entries[id].value);
    vec4 s = all_spheres[pc.sphere_id].spheres[block_id].data;
    
    all_bvhs[pc.bvh_id].nodes[leaf_buf_idx].min_p = vec4(s.xyz - vec3(s.w), 0.0);
    all_bvhs[pc.bvh_id].nodes[leaf_buf_idx].max_p = vec4(s.xyz + vec3(s.w), 0.0);
    all_bvhs[pc.bvh_id].nodes[leaf_buf_idx].left = -1;
    all_bvhs[pc.bvh_id].nodes[leaf_buf_idx].right = -1;

    // 2. Climb from leaf to root
    int curr = all_parents[pc.parent_id].parents[leaf_buf_idx];
    
    for (int i = 0; i < 128; ++i) {
        if (curr == -1) break;

        memoryBarrierBuffer();
        uint count = atomicAdd(all_atomics[pc.atomic_id].counters[curr], 1);
        if (count == 0) return; // First thread exits
        memoryBarrierBuffer(); // Second thread sees child writes

        int left = all_bvhs[pc.bvh_id].nodes[curr].left;
        int right = all_bvhs[pc.bvh_id].nodes[curr].right;

        uint l_idx = (left < 0) ? (N - 1 + (-left - 1)) : uint(left);
        uint r_idx = (right < 0) ? (N - 1 + (-right - 1)) : uint(right);

        vec3 l_min = all_bvhs[pc.bvh_id].nodes[l_idx].min_p.xyz;
        vec3 l_max = all_bvhs[pc.bvh_id].nodes[l_idx].max_p.xyz;
        vec3 r_min = all_bvhs[pc.bvh_id].nodes[r_idx].min_p.xyz;
        vec3 r_max = all_bvhs[pc.bvh_id].nodes[r_idx].max_p.xyz;

        all_bvhs[pc.bvh_id].nodes[curr].min_p = vec4(min(l_min, r_min), 0.0);
        all_bvhs[pc.bvh_id].nodes[curr].max_p = vec4(max(l_max, r_max), 0.0);

        curr = all_parents[pc.parent_id].parents[curr];
    }
}
