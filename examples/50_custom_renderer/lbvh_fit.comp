#version 450
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

struct Entry {
    uint64_t key;
    uint64_t value;
};

struct Sphere {
    vec4 data; // x, y, z, r
};

struct BVHNode {
    int left;   
    int right;
    int pad0, pad1;
    vec4 min_p; 
    vec4 max_p; 
};

layout(set = 0, binding = 0, scalar) buffer SortBuffer { Entry entries[]; } all_entries[];
layout(set = 0, binding = 0, scalar) buffer SphereSoA { Sphere spheres[]; } all_spheres[];
layout(set = 0, binding = 0, scalar) coherent buffer BVHBuffer { BVHNode nodes[]; } all_bvhs[];
layout(set = 0, binding = 0, scalar) coherent buffer AtomicBuffer { uint counters[]; } all_atomics[];
layout(set = 0, binding = 0, scalar) buffer ParentBuffer { int parents[]; } all_parents[];

layout(push_constant) uniform PC {
    uint sphere_id;
    uint entry_id;
    uint bvh_id;
    uint atomic_id;
    uint parent_id;
    uint num_leaves;
} pc;

layout (local_size_x = 256) in;

void main() {
    uint id = gl_GlobalInvocationID.x;
    uint N = pc.num_leaves;
    if (id >= N) return;

    // Start from leaf 'id'
    int curr = all_parents[pc.parent_id].parents[N - 1 + id];
    
    for (int i = 0; i < 64; ++i) {
        if (curr == -1) break;

        // Barrier 1: Flush my child's AABB writes before I signal completion
        memoryBarrierBuffer();
        
        uint count = atomicAdd(all_atomics[pc.atomic_id].counters[curr], 1);
        if (count == 0) return; // First thread to arrive exits

        // Barrier 2: Ensure I see the other thread's child-AABB writes
        memoryBarrierBuffer();

        int left = all_bvhs[pc.bvh_id].nodes[curr].left;
        int right = all_bvhs[pc.bvh_id].nodes[curr].right;

        vec3 l_min, l_max, r_min, r_max;

        if (left < 0) {
            uint l_idx = uint(all_entries[pc.entry_id].entries[-left - 1].value);
            vec4 s = all_spheres[pc.sphere_id].spheres[l_idx].data;
            l_min = s.xyz - vec3(s.w); l_max = s.xyz + vec3(s.w);
        } else {
            l_min = all_bvhs[pc.bvh_id].nodes[left].min_p.xyz;
            l_max = all_bvhs[pc.bvh_id].nodes[left].max_p.xyz;
        }

        if (right < 0) {
            uint r_idx = uint(all_entries[pc.entry_id].entries[-right - 1].value);
            vec4 s = all_spheres[pc.sphere_id].spheres[r_idx].data;
            r_min = s.xyz - vec3(s.w); r_max = s.xyz + vec3(s.w);
        } else {
            r_min = all_bvhs[pc.bvh_id].nodes[right].min_p.xyz;
            r_max = all_bvhs[pc.bvh_id].nodes[right].max_p.xyz;
        }

        // Safety: If somehow we still see infinity, don't propagate it
        l_min = clamp(l_min, vec3(-100.0), vec3(100.0));
        l_max = clamp(l_max, vec3(-100.0), vec3(100.0));
        r_min = clamp(r_min, vec3(-100.0), vec3(100.0));
        r_max = clamp(r_max, vec3(-100.0), vec3(100.0));

        all_bvhs[pc.bvh_id].nodes[curr].min_p = vec4(min(l_min, r_min), 0.0);
        all_bvhs[pc.bvh_id].nodes[curr].max_p = vec4(max(l_max, r_max), 0.0);

        curr = all_parents[pc.parent_id].parents[curr];
    }
}
