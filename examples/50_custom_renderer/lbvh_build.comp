#version 450
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

struct Entry {
    uint64_t key;
    uint64_t value;
};

struct BVHNode {
    int left;   
    int right;
    int pad0, pad1;
    vec4 min_p; 
    vec4 max_p; 
};

layout(set = 0, binding = 0, scalar) buffer SortBuffer { Entry entries[]; } all_entries[];
layout(set = 0, binding = 0, scalar) buffer BVHBuffer { BVHNode nodes[]; } all_bvhs[];
layout(set = 0, binding = 0, scalar) buffer ParentBuffer { int parents[]; } all_parents[];

layout(push_constant) uniform PC {
    uint entry_id;
    uint bvh_id;
    uint parent_id;
    uint num_leaves;
} pc;

int delta(int i, int j) {
    if (j < 0 || j >= int(pc.num_leaves)) return -1;
    uint64_t a = all_entries[pc.entry_id].entries[i].key;
    uint64_t b = all_entries[pc.entry_id].entries[j].key;
    uint64_t diff = a ^ b;
    uint hi = uint(diff >> 32);
    if (hi != 0) return 31 - findMSB(hi);
    return 32 + (31 - findMSB(uint(diff & 0xFFFFFFFFu)));
}

layout (local_size_x = 256) in;

void main() {
    int i = int(gl_GlobalInvocationID.x);
    int N = int(pc.num_leaves);
    if (i >= N - 1) return;

    // --- Aila & Laine (2013) Edge-Based Mapping ---
    // Internal node 'i' represents the split between sorted entry 'i' and 'i+1'.
    int d_i = delta(i, i + 1);

    // 1. Find range [L, R] where split 'i' is the coarsest (smallest delta)
    // Left boundary L: nearest split to the left that is coarser than d_i
    int L = i;
    while (L > 0 && delta(L - 1, L) > d_i) L--;

    // Right boundary R: nearest split to the right that is coarser than d_i
    int R = i;
    while (R < N - 2 && delta(R + 1, R + 2) > d_i) R++;
    // Range of leaves covered by this subtree is [L, R+1]

    // 2. Find Children
    int left_child, right_child;

    // Left child is either Leaf L (if L == i) or the split in [L, i-1] with smallest delta
    if (L == i) {
        left_child = -i - 1; // Leaf i
        all_parents[pc.parent_id].parents[N - 1 + i] = i;
    } else {
        // The left child is the unique split in [L, i-1] that is the coarsest
        // In this Edge-Based scheme, it's the split that covers the range [L, i-1]
        // Which is the split j in [L, i-1] such that delta(j, j+1) is minimal.
        int best_j = i - 1;
        int best_d = delta(i - 1, i);
        for (int j = i - 2; j >= L; j--) {
            int d_j = delta(j, j + 1);
            if (d_j < best_d) { best_d = d_j; best_j = j; }
        }
        left_child = best_j;
        all_parents[pc.parent_id].parents[left_child] = i;
    }

    // Right child is either Leaf R+1 (if R == i) or the coarsest split in [i+1, R]
    if (R == i) {
        right_child = -(i + 1) - 1; // Leaf i+1
        all_parents[pc.parent_id].parents[N - 1 + i + 1] = i;
    } else {
        int best_k = i + 1;
        int best_d = delta(i + 1, i + 2);
        for (int k = i + 2; k <= R; k++) {
            int d_k = delta(k, k + 1);
            if (d_k < best_d) { best_d = d_k; best_k = k; }
        }
        right_child = best_k;
        all_parents[pc.parent_id].parents[right_child] = i;
    }

    all_bvhs[pc.bvh_id].nodes[i].left = left_child;
    all_bvhs[pc.bvh_id].nodes[i].right = right_child;

    // 3. Root Handling
    if (L == 0 && R == N - 2) {
        all_parents[pc.parent_id].parents[i] = -1;
    }
}
