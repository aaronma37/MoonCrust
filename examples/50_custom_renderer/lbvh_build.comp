#version 450
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

struct Entry { uint64_t key, value; };
struct BVHNode { int left, right; int pad0, pad1; vec4 min_p, max_p; };

layout(set = 0, binding = 0, scalar) buffer SortBuffer { Entry entries[]; } all_entries[];
layout(set = 0, binding = 0, scalar) buffer BVHBuffer { BVHNode nodes[]; } all_bvhs[];
layout(set = 0, binding = 0, scalar) buffer ParentBuffer { int parents[]; } all_parents[];

layout(push_constant) uniform PC { uint entry_id, bvh_id, parent_id, num_leaves; } pc;

// Simple, robust delta function using the now-unique keys
int delta(int i, int j) {
    if (j < 0 || j >= int(pc.num_leaves)) return -1;
    uint64_t a = all_entries[pc.entry_id].entries[i].key;
    uint64_t b = all_entries[pc.entry_id].entries[j].key;
    uint64_t diff = a ^ b;
    if (diff == 0) return 64 + (31 - findMSB(uint(i ^ j))); // Same key (impossible now), use index
    uint hi = uint(diff >> 32);
    if (hi != 0) return 31 - findMSB(hi);
    return 32 + (31 - findMSB(uint(diff & 0xFFFFFFFFu)));
}

layout (local_size_x = 256) in;

void main() {
    int i = int(gl_GlobalInvocationID.x);
    int n = int(pc.num_leaves);
    if (i >= n - 1) return;

    // 1. Determine direction d
    int d = (delta(i, i + 1) - delta(i, i - 1) >= 0) ? 1 : -1;

    // 2. Compute upper bound l_max
    int delta_min = delta(i, i - d);
    int l_max = 2;
    while (delta(i, i + l_max * d) > delta_min) {
        l_max *= 2;
        if (i + l_max * d < 0 || i + l_max * d >= n) break;
    }

    // 3. Find j with binary search
    int l = 0;
    for (int t = l_max / 2; t >= 1; t /= 2) {
        if (delta(i, i + (l + t) * d) > delta_min) l += t;
    }
    int j = i + l * d;

    // 4. Find split s with binary search
    int delta_node = delta(i, j);
    int s = 0;
    for (int t = (l + 1) / 2; t >= 1; t = (t + 1) / 2) {
        if (delta(i, i + (s + t) * d) > delta_node) s += t;
        if (t == 1) break;
    }
    int split = i + s * d + min(d, 0);

    // 5. Children assignments
    int left_child = (min(i, j) == split) ? (-split - 1) : split;
    int right_child = (max(i, j) == split + 1) ? (-(split + 1) - 1) : (split + 1);

    all_bvhs[pc.bvh_id].nodes[i].left = left_child;
    all_bvhs[pc.bvh_id].nodes[i].right = right_child;

    // 6. Set parents for children
    int l_idx = (left_child < 0) ? (n - 1 + (-left_child - 1)) : left_child;
    int r_idx = (right_child < 0) ? (n - 1 + (-right_child - 1)) : right_child;
    all_parents[pc.parent_id].parents[l_idx] = i;
    all_parents[pc.parent_id].parents[r_idx] = i;
}
